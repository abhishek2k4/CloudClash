PORT=5000
CLIENT_ORIGIN=http://localhost:5173
HOST_PASSWORD=change-this-before-event

# Local development defaults to memory-only; set PERSISTENCE_ENABLED=true to use Supabase.
# Production enables persistence when credentials are present.
PERSISTENCE_ENABLED=false

# Supabase persistence (keep the Secret key server-side only)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-secret-key
