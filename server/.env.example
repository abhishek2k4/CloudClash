PORT=5000
CLIENT_ORIGIN=http://localhost:5173
COMPETITION_CODE=CLOUD26
HOST_PASSWORD=change-this-before-event
ROUND_1_SECONDS=20
ROUND_2_SECONDS=30

# Local development defaults to memory-only; set PERSISTENCE_ENABLED=true to use Supabase.
# Production (NODE_ENV=production) enables persistence when credentials are present.
PERSISTENCE_ENABLED=false

# Supabase persistence (keep the service-role key server-side only)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
